  _collectionEntries:
  - _entryName: "\uC194\uB2E4\uD1A0"
    _entryGroup: "\uB3C4\uBBF8\uB2C8\uC624"
    _entryDescription: "\uC138\uB825: \uB3C4\uBBF8\uB2C8\uC624 (\uB9C8\uD53C\uC544)\n\uB4F1\uAE09:
      \uAE30\uBCF8 \uBAB9\n\uAE30\uC220: L, H, D\n\uAC8C\uC774\uC9C0: \uAC00\uB4DC
      \uAC8C\uC774\uC9C0 3\uCE78 / \uBD84\uB178 \uAC8C\uC774\uC9C0 1\uCE78\n\n\uB77C\uC774\uD504
      \uC2DC\uD2F0\uC5D0 \uC788\uB294 \uAE30\uC5C5\uD615 \uBC94\uC8C4\uC870\uC9C1.
      \uC8FC\uB85C \uD074\uB7FD\uACFC \uACBD\uD638\uC5C5 \uAC19\uC740 \uC0AC\uC5C5\uCCB4\uB97C
      \uAD74\uB9AC\uACE0, \uB2E4\uB978 \uC0AC\uC5C5\uC7A5\uC73C\uB85C\uBD80\uD130
      \uBCF4\uD638\uBE44\uB97C \uBC1B\uC73C\uBA70 \uC218\uC775\uC744 \uB298\uB9B0\uB2E4."
    _entryIcon: {fileID: 0}
    _linkedItem: {fileID: 0}
  - _entryName: "\uCE74\uD3EC"
    _entryGroup: "\uB3C4\uBBF8\uB2C8\uC624"
    _entryDescription: "\uC138\uB825: \uB3C4\uBBF8\uB2C8\uC624 (\uB9C8\uD53C\uC544)\n\uB4F1\uAE09:
