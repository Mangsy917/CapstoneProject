  - _entryName: "\uCEE8\uD2B8\uB799\uD130"
    _entryGroup: "\uB808\uC9C0\uC2A4\uD0D5\uC2A4"
    _entryDescription: "\uC138\uB825: \uB808\uC9C0\uC2A4\uD0D5\uC2A4\n\uB4F1\uAE09:
      \uAE30\uBCF8 \uBAB9\n\uAE30\uC220: L, H, D\n\uAC8C\uC774\uC9C0: \uAC00\uB4DC
      \uAC8C\uC774\uC9C0 3\uCE78 / \uBD84\uB178 \uAC8C\uC774\uC9C0 1\uCE78\n\n\uAE30\uC5C5\uB3C4\uC2DC\uC758
      \uCCB4\uC81C\uC5D0 \uBC18\uAC10\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uB4E4\uC774
      \uB9CC\uB4E0 \uC870\uC9C1. \uCC98\uC74C\uC5D0\uB294 \uBE48\uBBFC\uAC00\uB098
      \uBD80\uC801\uC751\uC790\uB4E4\uC744 \uB3C4\uC654\uC9C0\uB9CC, \uC2DC\uAC04\uC774
      \uC9C0\uB098\uBA74\uC11C \uAE30\uC5C5\uC744 \uB04C\uC5B4\uB0B4\uB9AC\uB294
      \uBAA9\uD45C\uB9CC \uB0A8\uAC8C \uB418\uC5C8\uB2E4."
    _entryIcon: {fileID: 0}
    _linkedItem: {fileID: 0}
