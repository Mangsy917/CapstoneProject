    _linkedItem: {fileID: 0}
  - _entryName: "\uC5B8\uB354\uBCF4\uC2A4"
    _entryGroup: "\uB3C4\uBBF8\uB2C8\uC624"
    _entryDescription: "\uC138\uB825: \uB3C4\uBBF8\uB2C8\uC624 (\uB9C8\uD53C\uC544)\n\uB4F1\uAE09:
      \uCD5C\uC885\uBCF4\uC2A4\n\uAE30\uC220: L, H, D, OD, \uCD08\uD544\uC0B4\uAE30,
      \uC7A1\uAE30\n\uAC8C\uC774\uC9C0: \uAC00\uB4DC \uAC8C\uC774\uC9C0 6\uCE78 /
      \uBD84\uB178 \uAC8C\uC774\uC9C0 5\uCE78\n\n\uB77C\uC774\uD504 \uC2DC\uD2F0\uC5D0
      \uC788\uB294 \uAE30\uC5C5\uD615 \uBC94\uC8C4\uC870\uC9C1. \uC8FC\uB85C \uD074\uB7FD\uACFC
      \uACBD\uD638\uC5C5 \uAC19\uC740 \uC0AC\uC5C5\uCCB4\uB97C \uAD74\uB9AC\uACE0,
      \uB2E4\uB978 \uC0AC\uC5C5\uC7A5\uC73C\uB85C\uBD80\uD130 \uBCF4\uD638\uBE44\uB97C
      \uBC1B\uC73C\uBA70 \uC218\uC775\uC744 \uB298\uB9B0\uB2E4."
    _entryIcon: {fileID: 0}
    _linkedItem: {fileID: 0}
  - _entryName: "\uB8E8\uD0A4"
    _entryGroup: "\uD558\uCE74\uC774\uAD6C\uBBF8"
    _entryDescription: "\uC138\uB825: \uD558\uCE74\uC774\uAD6C\uBBF8 (\uD3ED\uC8FC\uC871)\n\uB4F1\uAE09:
      \uAE30\uBCF8 \uBAB9\n\uAE30\uC220: L, H, D\n\uAC8C\uC774\uC9C0: \uAC00\uB4DC
      \uAC8C\uC774\uC9C0 3\uCE78 / \uBD84\uB178 \uAC8C\uC774\uC9C0 1\uCE78\n\n\uB77C\uC774\uD504
      \uC2DC\uD2F0 \uC678\uACFD\uC5D0 \uC790\uB9AC \uC7A1\uC740 \uBB34\uBC95\uC790\uB4E4.
      \uB3C4\uC2DC\uC758 \uBD80\uC801\uC751\uC790\uB4E4 \uC911 \uACFC\uACA9\uD55C
      \uC0AC\uB78C\uB4E4\uC774 \uBAA8\uC5EC \uB9CC\uB4E4\uC5B4\uC9C4 \uC870\uC9C1.
      \uC8FC\uB85C \uAE30\uC5C5\uC758 \uC6B4\uC1A1\uCC28\uB7C9\uC744 \uC2B5\uACA9\uD558\uACE0
      \uAC08\uCDE8\uD55C \uBB3C\uAC74\uB4E4\uB85C \uC218\uC775\uC744 \uC62C\uB9B0\uB2E4."
    _entryIcon: {fileID: 0}
    _linkedItem: {fileID: 0}
