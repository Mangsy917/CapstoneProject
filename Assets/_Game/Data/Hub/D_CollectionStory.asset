  _collectionEntries:
  - _entryName: "\uC804\uC81C \uC2A4\uD1A0\uB9AC"
    _entryGroup: 
    _entryDescription: "\uAE30\uC5C5\uC758 \uC784\uBB34 \uB3C4\uC911 \uAE30\uC2B5\uC744
      \uBC1B\uC740 \uC8FC\uC778\uACF5\uACFC \uB3D9\uB8CC\uB4E4. \uC624\uB79C \uB3D9\uB8CC\uAC00
      \uBAB8\uC744 \uB358\uC838 \uC8FC\uC778\uACF5\uC744 \uAD6C\uD574\uB0B4\uACE0
      \uB300\uC2E0 \uBAA9\uC228\uC744 \uC783\uC5C8\uB2E4.\n\n\uC5D0\uB374 \uCF54\uD37C\uB808\uC774\uC158\uC740
      \uB354 \uC774\uC0C1 \uC4F8\uBAA8\uAC00 \uC5C6\uB2E4\uACE0 \uD310\uB2E8\uD55C
      \uC8FC\uC778\uACF5\uC5D0\uAC8C \uC758\uC218 \uD558\uB098\uB9CC\uC744 \uC950\uC5EC\uC900
      \uCC44 \uAC15\uC81C\uB85C \uC740\uD1F4\uC2DC\uCF30\uB2E4.\n\n\uADF8\uB7EC\uB358
      \uC5B4\uB290 \uB0A0, \uC554\uC0C1\uC778\uC5D0\uAC8C \uADF8 \uAE30\uC2B5\uC774
      \uACB0\uCF54 \uC6B0\uC5F0\uC774 \uC544\uB2C8\uB77C\uB294 \uC0AC\uC2E4\uC744
      \uB4E3\uAC8C \uB41C \uC8FC\uC778\uACF5\uC740 \uC9C4\uC0C1\uC744 \uD30C\uC545\uD558\uAE30
      \uC704\uD574 \uC804\uC7A5\uC5D0 \uBCF5\uADC0\uD558\uAE30\uB85C \uACB0\uC2EC\uD588\uB2E4."
